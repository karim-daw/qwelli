# PostgreSQL password for local docker-compose postgres service
POSTGRES_PASSWORD=qwelli

# Database name and user for docker-compose
POSTGRES_DB=qwelli
POSTGRES_USER=qwelli

# Database connection for CLI usage (when docker-compose is running)
# For Docker Compose: use 'postgres' as hostname
DATABASE_URL=postgresql://qwelli:qwelli@postgres:5432/qwelli?sslmode=disable

# For local development without Docker:
# DATABASE_URL=postgresql://qwelli:qwelli@localhost:5432/qwelli?sslmode=disable

# For production with managed PostgreSQL (Azure, AWS, etc.):
# DATABASE_URL=postgresql://user:password@your-db-host:5432/qwelli?sslmode=require

# ====================================================================
# Voyage AI Configuration (REQUIRED)
# ====================================================================
# Get your API key at: https://www.voyageai.com/

# Your Voyage AI API key (REQUIRED)
VOYAGE_API_KEY=your_voyage_api_key_here

# Voyage AI embedding model
VOYAGE_MODEL=voyage-multimodal-3

# Voyage AI API endpoint (usually doesn't need to change)
VOYAGE_EMBEDDING_ENDPOINT=https://api.voyageai.com/v1/multimodalembeddings

# Optional: Enable search result reranking
ENABLE_RERANKER=true
VOYAGE_RERANK_MODEL=rerank-2
VOYAGE_RERANK_ENDPOINT=https://api.voyageai.com/v1/rerank

# ====================================================================
# Application Configuration (Optional)
# ====================================================================

# Server port (default: 8080)
PORT=8080

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ====================================================================
# Docker PostgreSQL Configuration (Optional)
# ====================================================================
# These are only used by docker-compose to initialize PostgreSQL
# Change these if you want different default database credentials

# POSTGRES_PORT=5432
# POSTGRES_HOST=postgres

# ====================================================================
# Production Deployment Notes
# ====================================================================
# When deploying to production with managed PostgreSQL:
# 1. Update DATABASE_URL to point to your managed database
# 2. Make sure pgvector extension is enabled in your managed database
# 3. Run: docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# 4. Keep VOYAGE_API_KEY secure (use secrets management in production)
