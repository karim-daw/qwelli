# Qwelli Configuration
# Copy this file to .env and fill in your values

# ============================================
# Embedding Provider Configuration
# ============================================

# Provider to use: "openai" (default) or "cohere"
QWELLI_EMBEDDING_PROVIDER=openai

# Optional: Override the default model for the selected provider
# OpenAI models: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
# Cohere models: embed-english-v3.0, embed-multilingual-v3.0, embed-english-light-v3.0
# QWELLI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# API Keys (Required)
# ============================================

# OpenAI API Key (required if using OpenAI provider)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Cohere API Key (required if using Cohere provider)
# Get your key from: https://dashboard.cohere.ai/api-keys
# COHERE_API_KEY=your-cohere-api-key-here

# ============================================
# Optional: Custom API Endpoints
# ============================================

# Uncomment to use custom endpoints (e.g., for proxies or self-hosted)
# OPENAI_API_ENDPOINT=https://api.openai.com/v1/embeddings
# COHERE_API_ENDPOINT=https://api.cohere.ai/v1/embed
