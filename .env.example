# =============================================================================
# Qwelli Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Local Development (Docker Compose + CLI)
# -----------------------------------------------------------------------------

# PostgreSQL password for local docker-compose postgres service
POSTGRES_PASSWORD=qwelli

# Database connection for CLI usage (automatically loaded by qwelli commands)
# Use this when docker-compose is running locally
DATABASE_URL=postgresql://qwelli:qwelli@localhost:5432/qwelli?sslmode=disable

# Voyage AI API Key (REQUIRED)
VOYAGE_API_KEY=your_voyage_api_key_here

# Optional: Override postgres defaults
# POSTGRES_DB=qwelli
# POSTGRES_USER=qwelli
# POSTGRES_PORT=5432

# Optional: Override application port
# APP_PORT=8080

# -----------------------------------------------------------------------------
# Production Deployment (Managed PostgreSQL)
# -----------------------------------------------------------------------------
# For production with managed PostgreSQL, use DATABASE_URL instead:

# Full PostgreSQL connection string (overrides docker-compose postgres)
# DATABASE_URL=postgresql://user:password@your-db-host.postgres.database.azure.com:5432/qwelli?sslmode=require

# -----------------------------------------------------------------------------
# Optional Configuration (with sensible defaults)
# -----------------------------------------------------------------------------

# Voyage AI models and endpoints
VOYAGE_MODEL=voyage-multimodal-3.5
VOYAGE_EMBEDDING_ENDPOINT=https://api.voyageai.com/v1/multimodalembeddings
VOYAGE_RERANK_MODEL=rerank-2
VOYAGE_RERANK_ENDPOINT=https://api.voyageai.com/v1/rerank

# Application server port
PORT=8080

# Enable search result reranking
ENABLE_RERANKER=true

# -----------------------------------------------------------------------------
# Production-Only Variables
# -----------------------------------------------------------------------------
# These are only needed when using docker-compose.prod.yml:

# Pre-built Docker image (for production deployments)
# DOCKER_IMAGE=your-registry.azurecr.io/qwelli:latest
