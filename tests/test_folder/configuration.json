{
  "application": {
    "name": "Qwelli",
    "version": "1.0.0",
    "description": "Local file search engine with semantic search"
  },
  "database": {
    "type": "duckdb",
    "path": "./data/qwelli.db",
    "vector_dimension": 384
  },
  "indexer": {
    "model": "all-MiniLM-L6-v2",
    "batch_size": 32,
    "max_file_size_mb": 10
  },
  "search": {
    "default_top_k": 10,
    "hnsw_m": 16,
    "hnsw_ef_construction": 200
  },
  "server": {
    "port": 8080,
    "host": "localhost",
    "timeout_seconds": 30
  }
}

