# Example Terraform variables file
# Copy this to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to version control!

# General Configuration
resource_group_name = "qwelli-rg"
location            = "eastus"
prefix              = "qwelli"
environment         = "development"

tags = {
  Environment = "development"
  Application = "Qwelli"
  ManagedBy   = "Terraform"
  Owner       = "your-name"
}

# Network Configuration
allowed_ip_range     = "0.0.0.0/0"  # Change to your IP range for security
enable_public_access = true          # Set false for production with VPN

# Database Configuration
db_name               = "qwelli"
db_admin_username     = "qwelliadmin"
db_password           = "CHANGE_ME_SecurePassword123!"  # Must be at least 12 characters
db_sku_name           = "B_Standard_B1ms"               # Burstable tier for dev
db_storage_mb         = 32768                           # 32 GB
db_backup_retention_days = 7
db_max_connections    = "100"
allow_azure_services  = true

# Container Registry Configuration
acr_sku = "Basic"  # Basic for dev, Standard or Premium for production

# Container Configuration
container_image_name = "qwelli"
container_image_tag  = "latest"
container_cpu        = 2  # vCores
container_memory     = 4  # GB

# Application Configuration
voyage_api_key    = "CHANGE_ME_your_voyage_api_key"
embedding_model   = "voyage-multimodal-3"
enable_multimodal = "true"
enable_reranker   = "true"
image_quality     = "medium"  # low, medium, or high

# Monitoring and Alerting
alert_email_addresses = [
  # "admin@example.com"
]
